# WordPress core — never tracked
/wp-admin/
/wp-includes/
/wp-*.php
!/wp-content/
/index.php
/license.txt
/readme.html
/xmlrpc.php

# WordPress config — env-specific
/wp-config.php
/wp-config-sample.php

# wp-content: track only what we own
/wp-content/*
!/wp-content/mu-plugins/
!/wp-content/themes/
/wp-content/plugins/
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/cache/
/wp-content/languages/
/wp-content/wp-rocket-config/
/wp-content/advanced-cache.php
/wp-content/object-cache.php
/wp-content/db.php
/wp-content/debug.log
/wp-content/*.log

# mu-plugins: track only ibv-core
/wp-content/mu-plugins/*
!/wp-content/mu-plugins/ibv-core/
!/wp-content/mu-plugins/ibv-core.php

# themes: track only our themes
/wp-content/themes/*
!/wp-content/themes/ibiza-villas-2000/
!/wp-content/themes/ibv/

# Local backup of former nested repo (git bundle)
/.git-backup-*.bundle

# Fresh-init .git backup (directory — never track)
/.git-fresh-init-backup/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
